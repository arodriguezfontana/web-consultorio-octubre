---
interface Props {
  href?: string;
  class?: string;
}

const { href = "/contacto", class: className = "" } = Astro.props;
---

<a
  href={href}
  class={`group relative inline-flex items-center justify-center gap-2.5 px-5 py-2.5 rounded-full text-xs font-semibold tracking-wide uppercase text-secondary bg-white border border-slate-200 shadow-2xs hover:border-slate-300 hover:text-secondary hover:shadow-md transition-all duration-300 outline-none select-none [-webkit-tap-highlight-color:transparent] ${className}`}
>
  <span class="relative flex h-2 w-2">
    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
    <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
  </span>

  <span><slot>Pedir Turno</slot></span>

  <svg 
    xmlns="http://www.w3.org/2000/svg" 
    class="w-3.5 h-3.5 text-slate-300 group-hover:text-slate-400 group-hover:translate-x-0.5 transition-all duration-300" 
    fill="none" 
    viewBox="0 0 24 24" 
    stroke="currentColor" 
    stroke-width="2"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
  </svg>
</a>