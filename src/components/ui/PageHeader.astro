---
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
}

const { badge, title, subtitle } = Astro.props;
---

<section class="bg-neutral-surface border-b border-slate-200/80 py-6 sm:py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
      <div class="space-y-1">
        {badge && (
          <span class="text-xs font-bold uppercase tracking-wider text-primary block">
            {badge}
          </span>
        )}
        <h1 class="text-2xl sm:text-3xl font-bold text-neutral-title tracking-tight">
          {title}
        </h1>
      </div>

      {subtitle && (
        <p class="text-xs sm:text-sm text-neutral-text max-w-md">
          {subtitle}
        </p>
      )}
    </div>
  </div>
</section>