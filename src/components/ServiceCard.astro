---
import type { ServiceItem } from '../data/servicesData';
import { siteData } from '../data/siteData';
import Icon from './ui/Icon.astro';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;

const customWhatsappUrl = `https://wa.me/${siteData.contact.phone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(`Hola! Quisiera realizar una consulta sobre el área de ${service.title}.`)}`;
---

<details 
  id={service.id}
  class="bg-neutral-surface rounded-2xl border border-slate-200/80 shadow-xs des:border-primary/40 transition-all duration-200 group overflow-hidden"
>
  <summary class="p-6 cursor-pointer flex items-center justify-between gap-4 select-none list-none [&::-webkit-details-marker]:hidden">
    <div class="flex items-center gap-4">
      <div class="w-10 h-10 rounded-xl bg-primary-extra-light text-primary flex items-center justify-center shrink-0">
        <Icon name="check" class="w-5 h-5" />
      </div>
      <div>
        <h3 class="text-lg font-bold text-neutral-title group-hover:text-primary transition-colors">
          {service.title}
        </h3>
        <p class="text-xs text-neutral-text line-clamp-1 mt-0.5">
          {service.description}
        </p>
      </div>
    </div>
    
    <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center shrink-0 text-slate-500 group-open:rotate-180 transition-transform">
      <Icon name="arrow-right" class="w-4 h-4 rotate-90" />
    </div>
  </summary>

  <div class="px-6 pb-6 pt-2 border-t border-slate-100 space-y-4">
    {service.items && service.items.length > 0 && (
      <div class="bg-slate-50 p-4 rounded-xl space-y-2">
        <span class="text-xs font-semibold text-slate-500 uppercase tracking-wider block">Areas de intervención</span>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-neutral-text">
          {service.items.map((item) => (
            <div class="flex items-center gap-2">
              <Icon name="check" class="w-3.5 h-3.5 text-accent shrink-0" />
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>
    )}

    <div class="pt-2 flex justify-end">
      <a 
        href={customWhatsappUrl} 
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-primary hover:bg-primary-hover transition-colors"
      >
        <span>Realizar consulta</span>
        <Icon name="arrow-right" class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</details>