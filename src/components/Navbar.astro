---
import TopBar from './TopBar.astro';
import NavLink from './ui/NavLink.astro';
import ButtonCTA from './ui/ButtonCTA.astro';
import { siteData } from '../data/siteData';

const navItems = [
  { href: "/", label: "Espacio" },
  { href: "/servicios", label: "Servicios" },
  { href: "/profesionales", label: "Equipo" },
  { href: "/faq", label: "Preguntas Frecuentes" },
  { href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;
---

<div class="sticky top-0 z-40">
  <div class="hidden md:block">
    <TopBar />
  </div>
  
  <header class="bg-neutral-surface/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
      
      <a href="/" class="flex items-center gap-3 text-left focus:outline-none group py-2">
        <div class="flex flex-col cursor-pointer">
          <span class="text-xl font-bold text-secondary tracking-tight leading-none group-hover:text-primary transition-colors">
            {siteData.name}
          </span>
          <span class="text-xs font-medium text-primary tracking-wide mt-0.5">
            {siteData.subtitle}
          </span>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-2 h-full" aria-label="Navegación principal">
        {navItems.map((item) => (
          <NavLink href={item.href} label={item.label} />
        ))}
      </nav>

      <div class="hidden md:flex items-center">
        <ButtonCTA href={siteData.contact.whatsappUrl} />
      </div>

      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden inline-flex items-center justify-center p-2 rounded-xl text-neutral-text hover:text-secondary hover:bg-slate-100 focus:outline-none transition-colors select-none [-webkit-tap-highlight-color:transparent]"
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
      >
        <svg id="icon-menu" class="w-6 h-6 block" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

    </div>

    <div
      id="mobile-menu"
      class="hidden md:hidden border-t border-slate-200/80 bg-neutral-surface/98 backdrop-blur-md px-4 pt-3 pb-6 space-y-4 shadow-lg transition-all duration-200"
    >
      <nav class="flex flex-col space-y-1">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-4 py-2.5 rounded-xl text-base font-medium transition-colors ${
                isActive
                  ? "bg-primary-light text-secondary font-semibold"
                  : "text-neutral-text hover:text-secondary hover:bg-slate-100"
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="pt-2 border-t border-slate-100">
        <ButtonCTA href={siteData.contact.whatsappUrl} class="w-full text-center justify-center py-3 text-base" />
      </div>
    </div>
  </header>
</div>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (menuBtn && mobileMenu && iconMenu && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';

      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>