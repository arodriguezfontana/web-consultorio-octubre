---
import { siteData } from '../data/siteData';
import Icon from './ui/Icon.astro';
---

<div class="bg-secondary/90 text-white text-xs py-2 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
    
    <div class="flex items-center gap-4 text-white/90">
      <div class="flex items-center gap-1.5">
        <Icon name="location" class="w-3.5 h-3.5 text-primary-light shrink-0" />
        <span>{siteData.location.address}, {siteData.location.city}</span>
      </div>

      <div class="hidden md:flex items-center gap-1.5">
        <Icon name="clock" class="w-3.5 h-3.5 text-primary-light shrink-0" />
        <span>{siteData.contact.hours} / {siteData.contact.hourswe}</span>
      </div>
    </div>

    <div class="flex items-center gap-4">
      <a 
        href={siteData.contact.whatsappUrl} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-white hover:text-primary-light transition-colors focus:outline-none focus:underline font-medium"
        aria-label={`Contactar por WhatsApp al ${siteData.contact.phoneDisplay}`}
      >
        <Icon name="whatsapp" class="w-3.5 h-3.5 text-white shrink-0" />
        <span>{siteData.contact.phoneDisplay}</span>
      </a>

      <a 
        href={siteData.social.instagram} 
        target="_blank" 
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-white hover:text-primary-light transition-colors focus:outline-none focus:underline font-medium"
        aria-label={`Visitar Instagram de ${siteData.name}`}
      >
        <Icon name="instagram" class="w-3.5 h-3.5 text-white shrink-0" />
        <span>@espaciooctubre</span>
      </a>
    </div>

  </div>
</div>