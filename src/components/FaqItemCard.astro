---
import type { FaqItem } from '../data/faqData';
import Icon from './ui/Icon.astro';

interface Props {
  faq: FaqItem;
}

const { faq } = Astro.props;
---

<details class="border-b border-slate-200/80 py-4 group transition-colors">
  <summary class="cursor-pointer flex items-center justify-between gap-4 select-none list-none [&::-webkit-details-marker]:hidden py-2">
    <span class="text-base sm:text-lg font-medium text-neutral-title group-hover:text-primary transition-colors">
      {faq.question}
    </span>
    
    <span class="w-6 h-6 rounded-full flex items-center justify-center shrink-0 text-slate-400 group-hover:text-primary group-open:rotate-45 transition-transform duration-300 text-xl font-light">
      +
    </span>
  </summary>

  <div class="pt-2 pb-3 pr-8">
    <p class="text-neutral-text text-sm sm:text-base leading-relaxed">
      {faq.answer}
    </p>
  </div>
</details>