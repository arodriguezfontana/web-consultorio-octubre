---
import type { FaqItem } from '../data/faqData';
import Icon from './ui/Icon.astro';

interface Props {
  faq: FaqItem;
}

const { faq } = Astro.props;
---

<details class="bg-neutral-surface rounded-2xl border border-slate-200/80 border-l-4 border-l-secondary shadow-2xs hover:shadow-xs transition-all duration-300 group overflow-hidden">
  
  <summary class="p-5 sm:p-6 cursor-pointer flex items-center justify-between gap-4 select-none list-none [&::-webkit-details-marker]:hidden bg-neutral-surface group-open:bg-slate-50/50 transition-colors">
    <span class="text-base sm:text-lg font-medium text-neutral-title group-hover:text-primary transition-colors duration-200">
      {faq.question}
    </span>
    
    <div class="w-8 h-8 rounded-xl bg-slate-100 flex items-center justify-center shrink-0 text-slate-400 group-hover:text-primary group-open:rotate-180 group-open:bg-primary/10 group-open:text-primary transition-all duration-300">
      <Icon name="arrow-right" class="w-4 h-4 rotate-90" />
    </div>
  </summary>

  <div class="px-5 sm:px-6 pb-6 pt-1 text-neutral-text text-sm sm:text-base leading-relaxed border-t border-slate-100/60 bg-slate-50/30">
    {faq.answer}
  </div>

</details>