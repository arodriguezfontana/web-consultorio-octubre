---
import ButtonCTA from './ui/ButtonCTA.astro';
import { siteData } from '../data/siteData';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 border-t border-slate-800">
  
  <div class="bg-secondary/10 border-b border-slate-800 py-10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
      <div>
        <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
          ¿Querés coordinar una primera consulta?
        </h2>
        <p class="text-slate-400 text-sm mt-1">
          Estamos para acompañarte y responder las dudas sobre nuestro abordaje interdisciplinario.
        </p>
      </div>
      <div>
        <ButtonCTA href={siteData.contact.whatsappUrl}>
          Solicitar Turno
        </ButtonCTA>
      </div>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start justify-between">
      
      <div class="space-y-4 max-w-md">
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white tracking-tight">
            {siteData.name}
          </span>
          <span class="text-xs font-medium text-primary tracking-wide mt-0.5">
            {siteData.subtitle}
          </span>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          {siteData.description}
        </p>
        <div class="pt-2 flex items-center gap-2 text-xs text-slate-400">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          <span>{siteData.contact.modality}</span>
        </div>
      </div>

      <div class="md:justify-self-end max-w-md">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          Ubicación & Contacto
        </h3>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>{siteData.contact.address}<br />{siteData.contact.city}</span>
          </li>
          
          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.828-1.587-5.022-3.782-6.609-6.61l1.294-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
            </svg>
            <a href={siteData.contact.whatsappUrl} target="_blank" class="hover:text-white transition-colors">
              {siteData.contact.phoneDisplay}
            </a>
          </li>

          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href={`mailto:${siteData.contact.email}`} class="hover:text-white transition-colors">
              {siteData.contact.email}
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <div class="border-t border-slate-800/80 py-6 text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <p>© {currentYear} {siteData.name} {siteData.subtitle}. Todos los derechos reservados.</p>
      <p class="text-slate-600">
        Salud Mental, Psicopedagogía & Desarrollo Integral
      </p>
    </div>
  </div>

</footer>