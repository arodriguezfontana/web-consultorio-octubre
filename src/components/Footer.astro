---
import { siteData } from '../data/siteData';
import { navItems } from '../data/navigationData';
import Icon from './ui/Icon.astro';
import CtaBanner from './ui/CtaBanner.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-primary-dark text-slate-300">
  <CtaBanner />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14 border-b border-white/10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-12 items-start justify-between">
      
      <div class="space-y-4">
        <div class="flex flex-col border-l-2 border-l-accent pl-3.5">
          <span class="text-2xl font-semibold text-white tracking-tight">
            {siteData.name}
          </span>
          <span class="text-xs font-medium text-secondary-light tracking-wide mt-0.5">
            {siteData.subtitle}
          </span>
        </div>

        <p class="text-slate-300/90 text-xs sm:text-sm leading-relaxed max-w-sm">
          {siteData.description}
        </p>

        <div class="pt-1 flex items-center gap-2 text-xs text-accent-extra-light font-semibold ">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          <span>{siteData.contact.modality}</span>
        </div>
      </div>

      <div class="space-y-3 md:justify-self-center">
        <h3 class="text-xs font-medium text-white uppercase tracking-wider">
          Navegación
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          {navItems.map((item) => (
            <li>
              <a 
                href={item.href} 
                class="hover:text-white transition-all duration-200 flex items-center gap-1.5 group/nav"
              >
                <Icon name="arrow-right" class="w-3 h-3 text-secondary-light transition-transform group-hover/nav:translate-x-0.5" />
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-3 md:justify-self-end">
        <h3 class="text-xs font-medium text-white uppercase tracking-wider">
          Información
        </h3>
        <ul class="space-y-2.5 text-xs sm:text-sm">
          <li class="flex items-start gap-2.5">
            <Icon name="location" class="w-4 h-4 text-secondary-light shrink-0 mt-0.5" />
            <span>{siteData.location.address}, {siteData.location.city}</span>
          </li>

          <li class="flex items-center gap-2.5">
            <Icon name="clock" class="w-4 h-4 text-secondary-light shrink-0" />
            <span>{siteData.contact.hours} / {siteData.contact.hourswe}</span>
          </li>

          <li class="flex items-center gap-2.5">
            <Icon name="whatsapp" class="w-4 h-4 text-secondary-light shrink-0" />
            <a 
              href={siteData.contact.whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-white transition-colors font-medium"
            >
              {siteData.contact.phoneDisplay}
            </a>
          </li>

          <li class="flex items-center gap-2.5">
            <Icon name="instagram" class="w-4 h-4 text-secondary-light shrink-0" />
            <a 
              href={siteData.social.instagram} 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-white transition-colors font-medium"
            >
              @espaciooctubre
            </a>
          </li>

        </ul>
      </div>

    </div>
  </div>

  <div class="py-5 text-xs text-slate-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
      <p>© {currentYear} {siteData.name}. Todos los derechos reservados.</p>
    </div>
  </div>

</footer>