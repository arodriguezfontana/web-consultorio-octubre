---
import { siteData } from '../data/siteData';
import { navItems } from '../data/navigationData';
import Icon from './ui/Icon.astro';
import CtaBanner from './ui/CtaBanner.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-primary-dark text-slate-300">
  <CtaBanner />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16 border-b border-white/10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-12 items-start justify-between">
      
      <div class="space-y-4">
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white tracking-tight">
            {siteData.name}
          </span>
          <span class="text-xs font-medium text-secondary-light tracking-wide mt-0.5">
            {siteData.subtitle}
          </span>
        </div>

        <p class="text-slate-300 text-sm leading-relaxed">
          {siteData.description}
        </p>

        <div class="pt-1 flex items-center gap-2 text-xs text-slate-300">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          <span>{siteData.contact.modality}</span>
        </div>
      </div>

      <div class="space-y-3 md:justify-self-center">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">
          Navegación
        </h3>
        <ul class="space-y-2 text-sm">
          {navItems.map((item) => (
            <li>
              <a 
                href={item.href} 
                class="hover:text-white transition-colors flex items-center gap-1.5"
              >
                <Icon name="arrow-right" class="w-3 h-3 text-secondary-light" />
                <span>{item.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="space-y-3 md:justify-self-end">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider">
          Información
        </h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <Icon name="location" class="w-5 h-5 text-secondary-light shrink-0 mt-0.5" />
            <span>{siteData.location.address}, {siteData.location.city}</span>
          </li>

          <li class="flex items-center gap-3">
            <Icon name="clock" class="w-5 h-5 text-secondary-light shrink-0" />
            <span>{siteData.contact.hours}</span>
          </li>
          
          <li class="flex items-center gap-3">
            <Icon name="email" class="w-5 h-5 text-secondary-light shrink-0" />
            <a 
              href={`mailto:${siteData.contact.email}`} 
              class="hover:text-white transition-colors underline-offset-4 hover:underline"
            >
              {siteData.contact.email}
            </a>
          </li>

          <li class="flex items-center gap-3">
            <Icon name="whatsapp" class="w-5 h-5 text-secondary-light shrink-0" />
            <a 
              href={siteData.contact.whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="hover:text-white transition-colors font-medium underline-offset-4 hover:underline"
            >
              {siteData.contact.phoneDisplay}
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <div class="py-6 text-xs text-slate-400">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <p>© {currentYear} {siteData.name}. Todos los derechos reservados.</p>
      <p class="text-slate-500">{siteData.location.city}, Provincia de Buenos Aires</p>
    </div>
  </div>

</footer>