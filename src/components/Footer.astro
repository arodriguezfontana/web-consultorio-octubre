---
import ButtonCTA from './ui/ButtonCTA.astro';
import { siteData } from '../data/siteData';
import CtaBanner from './ui/CtaBanner.astro';

const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300">
  <CtaBanner 
    title="¿Querés coordinar tu primera entrevista?"
    description="Escribinos por WhatsApp y nuestro equipo te responderá a la brevedad."
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start justify-between">
      
      <div class="space-y-4 max-w-md">
        <div class="flex flex-col">
          <span class="text-2xl font-bold text-white tracking-tight">
            {siteData.name}
          </span>
          <span class="text-xs font-medium text-primary tracking-wide mt-0.5">
            {siteData.subtitle}
          </span>
        </div>
        <p class="text-slate-400 text-sm leading-relaxed">
          {siteData.description}
        </p>
        <div class="pt-2 flex items-center gap-2 text-xs text-slate-400">
          <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
          <span>{siteData.contact.modality}</span>
        </div>
      </div>

      <div class="md:justify-self-end max-w-md">
        <h3 class="text-sm font-semibold text-white uppercase tracking-wider mb-4">
          Información 
        </h3>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <span>{siteData.contact.address}</span>
          </li>

          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>{siteData.contact.hours}</span>
          </li>
          
          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <a href={`mailto:${siteData.contact.email}`} class="hover:text-white transition-colors">
              {siteData.contact.email}
            </a>
          </li>

          <li class="flex items-center gap-3">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white shrink-0 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <a href={siteData.contact.whatsappUrl} target="_blank" class="hover:text-white transition-colors">
              {siteData.contact.phoneDisplay}
            </a>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <div class="border-t border-slate-800/80 py-6 text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <p>© {currentYear} {siteData.name} {siteData.subtitle}. Todos los derechos reservados.</p>
      <p class="text-slate-600">
        Salud Mental, Psicopedagogía & Desarrollo Integral
      </p>
    </div>
  </div>

</footer>