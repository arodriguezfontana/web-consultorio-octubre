---
import ButtonCTA from './ui/ButtonCTA.astro';
import { siteData } from '../data/siteData';
---

<section class="relative w-full h-[80vh] min-h-125 max-h-187.5 bg-slate-900 overflow-hidden">
  <img 
    src="https://i.pinimg.com/originals/aa/e4/9f/aae49f60ab0295df8ed779bd7faf17c6.jpg" 
    alt="Instalaciones del consultorio Octubre" 
    class="w-full h-full object-cover object-center opacity-85"
    loading="eager"
  />

  <div class="absolute inset-0 bg-linear-to-t from-slate-950 via-slate-950/40 to-slate-950/20 flex items-end pb-12 sm:pb-16 md:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-3xl space-y-4">
        
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-secondary-light/90 text-secondary border border-primary/20 backdrop-blur-md">
          Salud Mental
        </span>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-extrabold text-white tracking-tight leading-tight">
          Un espacio de aprendizaje y acompañamiento
        </h1>

        <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
          Atención interdisciplinaria para niños, adolescentes y adultos. Un entorno cálido y seguro pensado para alojar cada proceso.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
          <ButtonCTA href={siteData.contact.whatsappUrl}>
            Solicitar Turno
          </ButtonCTA>
          <a 
            href="/servicios" 
            class="px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 transition-all duration-200 text-center"
          >
            Conocer Servicios
          </a>
        </div>

      </div>
    </div>
  </div>
</section>