---
import Layout from '../layouts/Layout.astro';
import ButtonCTA from '../components/ui/ButtonCTA.astro';
import { teamData } from '../data/teamData';
import { siteData } from '../data/siteData';
---

<Layout 
  title="Equipo Profesional | Octubre Consultorio"
  description="Conocé a las profesionales de Octubre: especialidades, trayectoria y horarios de atención en Psicología, Psicopedagogía, Fonoaudiología y Terapia Ocupacional."
>

  <section class="bg-neutral-surface border-b border-slate-200/80 py-12 sm:py-16">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-primary-light text-secondary border border-primary/20 mb-4">
        Equipo Interdisciplinario
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-title tracking-tight mb-4">
        Profesionales comprometidos con tu bienestar
      </h1>
      <p class="text-neutral-text text-base sm:text-lg leading-relaxed">
        Un equipo en constante formación y articulación constante para ofrecerte una mirada integral, cercana y respetuosa de cada proceso.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {teamData.map((member) => (
          <div class="bg-neutral-surface rounded-3xl border border-slate-200/80 border-t-4 border-t-primary shadow-sm hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col justify-between group">
            
            <div>
              <div class="relative h-64 w-full bg-slate-100 overflow-hidden">
                <img 
                  src={member.image} 
                  alt={`Foto de ${member.name}`}
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-linear-to-t from-slate-950/60 via-transparent to-transparent"></div>
                
                {member.badge && (
                  <span class="absolute top-4 right-4 px-3 py-1 rounded-full text-xs font-semibold bg-neutral-surface/90 backdrop-blur-md text-secondary border border-slate-200 shadow-xs">
                    {member.badge}
                  </span>
                )}
              </div>

              <div class="p-6 space-y-4">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-primary">
                    {member.role}
                  </span>
                  <h2 class="text-xl font-bold text-neutral-title mt-0.5">
                    {member.name}
                  </h2>
                  <p class="text-xs font-medium text-slate-500 mt-0.5">
                    {member.specialty}
                  </p>
                </div>

                <p class="text-neutral-text text-sm leading-relaxed">
                  {member.bio}
                </p>

                <div class="pt-3 border-t border-slate-100 flex items-start gap-2 text-xs text-slate-600 bg-slate-50 p-3 rounded-xl">
                  <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <div>
                    <span class="font-semibold text-neutral-title block">Horarios de atención:</span>
                    <span>{member.schedule}</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="p-6 pt-0">
              <a 
                href={siteData.contact.whatsappUrl}
                target="_blank"
                class="w-full py-2.5 px-4 rounded-xl text-xs font-bold text-secondary bg-primary-light hover:bg-primary/20 transition-colors flex items-center justify-center gap-2"
              >
                <span>Consultar turno con {member.name.split(' ')[1]}</span>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
              </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>