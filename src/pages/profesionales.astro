---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import TeamCard from '../components/TeamCard.astro';
import { teamData } from '../data/teamData';
---

<Layout 
  title="Equipo Profesional | Octubre Consultorio"
  description="Conocé a las profesionales de Octubre: especialidades, trayectoria y horarios de atención en Psicología, Psicopedagogía, Fonoaudiología y Terapia Ocupacional."
>

  <PageHeader 
    badge="Equipo Profesional"
    title="Conocé a nuestro equipo"
    description="Nuestro equipo interdisciplinario está compuesto por profesionales altamente capacitados en Psicología, Psicopedagogía, Fonoaudiología y Terapia Ocupacional. Cada miembro aporta su experiencia y dedicación para brindar una atención integral y personalizada."
  />
  <section class="py-8 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {teamData.map((member) => (
          <TeamCard member={member} />
        ))}
      </div>
    </div>
  </section>

</Layout>