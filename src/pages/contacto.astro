---
import Layout from '../layouts/Layout.astro';
import { siteData } from '../data/siteData';
---

<Layout 
  title="Contacto & Ubicación | Octubre Consultorio"
  description="Ponete en contacto con Octubre Consultorio Interdisciplinario. Escribinos por WhatsApp, email o envianos tu consulta."
>

  <section class="bg-neutral-surface border-b border-slate-200/80 py-12 sm:py-16">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-primary-light text-secondary border border-primary/20 mb-4">
        Contacto & Ubicación
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-title tracking-tight mb-4">
        Estamos para acompañarte
      </h1>
      <p class="text-neutral-text text-base sm:text-lg leading-relaxed">
        Ponete en contacto con nuestro equipo para coordinar un turno o resolver dudas sobre las disciplinas de atención.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 sm:space-y-16">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        
        <a 
          href={siteData.contact.whatsappUrl}
          target="_blank"
          class="bg-neutral-surface p-6 rounded-2xl border border-slate-200/80 border-t-4 border-t-accent shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-accent-light text-accent flex items-center justify-center mb-4">
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
            </div>
            <h3 class="text-base font-bold text-neutral-title mb-1">WhatsApp</h3>
            <p class="text-xs text-neutral-text mb-3">Atención rápida y coordinación de turnos.</p>
          </div>
          <span class="text-xs font-bold text-accent group-hover:underline">
            {siteData.contact.phoneDisplay} →
          </span>
        </a>

        <div class="bg-neutral-surface p-6 rounded-2xl border border-slate-200/80 border-t-4 border-t-primary shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-primary-light text-secondary flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-neutral-title mb-1">Ubicación</h3>
            <p class="text-xs text-neutral-text">{siteData.contact.address}</p>
          </div>
        </div>

        <a 
          href={`mailto:${siteData.contact.email}`}
          class="bg-neutral-surface p-6 rounded-2xl border border-slate-200/80 border-t-4 border-t-secondary shadow-xs hover:shadow-md transition-all duration-300 flex flex-col justify-between group"
        >
          <div>
            <div class="w-10 h-10 rounded-xl bg-secondary-light text-secondary flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-neutral-title mb-1">Correo Electrónico</h3>
            <p class="text-xs text-neutral-text mb-3">Para consultas institucionales o informes.</p>
          </div>
          <span class="text-xs font-bold text-secondary truncate group-hover:underline">
            {siteData.contact.email}
          </span>
        </a>

        <div class="bg-neutral-surface p-6 rounded-2xl border border-slate-200/80 border-t-4 border-t-primary shadow-xs flex flex-col justify-between">
          <div>
            <div class="w-10 h-10 rounded-xl bg-primary-light text-secondary flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-base font-bold text-neutral-title mb-1">Horarios</h3>
            <p class="text-xs text-neutral-text">{siteData.contact.hours}</p>
          </div>
          <span class="text-xs font-semibold text-slate-500 mt-3">{siteData.contact.modality}</span>
        </div>

      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">
        
        <div class="bg-neutral-surface p-8 rounded-3xl border border-slate-200/80 shadow-xs">
          <h2 class="text-xl font-bold text-neutral-title mb-2">
            Envianos tu consulta
          </h2>
          <p class="text-xs sm:text-sm text-neutral-text mb-6">
            Completá el formulario y nos pondremos en contacto con vos a la brevedad.
          </p>

          <form class="space-y-4">
            <div>
              <label for="nombre" class="block text-xs font-semibold text-neutral-title mb-1">
                Nombre y Apellido *
              </label>
              <input 
                type="text" 
                id="nombre" 
                name="nombre" 
                required 
                placeholder="Ej. Laura Pérez"
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-neutral-bg text-sm focus:outline-none focus:border-primary transition-colors"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="telefono" class="block text-xs font-semibold text-neutral-title mb-1">
                  Teléfono / WhatsApp *
                </label>
                <input 
                  type="tel" 
                  id="telefono" 
                  name="telefono" 
                  required 
                  placeholder="Ej. 11 1234 5678"
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-neutral-bg text-sm focus:outline-none focus:border-primary transition-colors"
                />
              </div>

              <div>
                <label for="especialidad" class="block text-xs font-semibold text-neutral-title mb-1">
                  Especialidad requerida
                </label>
                <select 
                  id="especialidad" 
                  name="especialidad" 
                  class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-neutral-bg text-sm focus:outline-none focus:border-primary transition-colors text-neutral-title"
                >
                  <option value="General">Consulta General</option>
                  <option value="Psicologia">Psicología</option>
                  <option value="Psicopedagogia">Psicopedagogía</option>
                  <option value="Fonoaudiologia">Fonoaudiología</option>
                  <option value="Terapia Ocupacional">Terapia Ocupacional</option>
                </select>
              </div>
            </div>

            <div>
              <label for="mensaje" class="block text-xs font-semibold text-neutral-title mb-1">
                Mensaje o Motivo de Consulta *
              </label>
              <textarea 
                id="mensaje" 
                name="mensaje" 
                rows="4" 
                required 
                placeholder="Contanos brevemente qué tipo de atención estás buscando..."
                class="w-full px-4 py-2.5 rounded-xl border border-slate-200 bg-neutral-bg text-sm focus:outline-none focus:border-primary transition-colors resize-none"
              ></textarea>
            </div>

            <button 
              type="submit" 
              class="w-full py-3 px-6 rounded-xl text-sm font-bold text-white bg-secondary hover:bg-primary transition-colors duration-200 shadow-xs cursor-pointer"
            >
              Enviar Mensaje
            </button>
          </form>
        </div>

        <div class="bg-neutral-surface rounded-3xl border border-slate-200/80 overflow-hidden shadow-xs flex flex-col h-full min-h-[400px]">
          <div class="p-6 border-b border-slate-100">
            <h3 class="text-lg font-bold text-neutral-title">
              Ubicación del Consultorio
            </h3>
            <p class="text-xs text-neutral-text mt-0.5">
              {siteData.contact.address}
            </p>
          </div>

          <div class="grow relative w-full h-full min-h-80">
            <iframe 
              title="Ubicación de Octubre Consultorio"
              src={siteData.contact.mapUrl} 
              class="absolute inset-0 w-full h-full border-0" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
            ></iframe>
          </div>
        </div>

      </div>

    </div>
  </section>

</Layout>