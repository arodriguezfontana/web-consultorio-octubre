---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { servicesData } from '../data/servicesData';
---

<Layout 
  title="Servicios & Especialidades | Octubre Consultorio"
  description="Conocé las disciplinas y especialidades de atención en Octubre: Psicología, Psicopedagogía, Fonoaudiología y Terapia Ocupacional."
>

  <!-- Componente Header Reutilizable -->
  <PageHeader 
    badge="Especialidades & Disciplinas"
    title="Atención integral para cada etapa"
    description="Ofrecemos un abordaje coordinado entre distintas áreas de la salud para brindar respuestas claras y acompañar el bienestar de niños, adolescentes, adultos y sus familias."
  />

  <!-- Grilla principal -->
  <section class="py-12 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {servicesData.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

</Layout>