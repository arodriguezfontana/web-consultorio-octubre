---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { servicesData } from '../data/servicesData';
---

<Layout 
  title="Servicios & Especialidades | Octubre Consultorio"
  description="Conocé las disciplinas y especialidades de atención en Octubre: Psicología, Psicopedagogía, Fonoaudiología y Terapia Ocupacional."
>

  <PageHeader 
    badge="Servicios & Especialidades"
    title="Conocé nuestras especialidades"
    description="En Octubre Consultorio Interdisciplinario ofrecemos un enfoque integral y personalizado en cada una de nuestras disciplinas: Psicología, Psicopedagogía, Fonoaudiología y Terapia Ocupacional. Nuestro equipo de profesionales altamente capacitados trabaja en conjunto para brindar atención de calidad y acompañamiento en cada proceso."
    />

  <section class="py-8 sm:py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        {servicesData.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </div>
  </section>

</Layout>