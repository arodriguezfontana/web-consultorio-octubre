---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import FaqItemCard from '../components/FaqItemCard.astro';
import { faqData } from '../data/faqData';
---

<Layout 
  title="Preguntas Frecuentes | Octubre Consultorio"
  description="Resolvemos tus dudas sobre solicitud de turnos, modalidades presencial y virtual, obras sociales, reintegros y primera consulta en Octubre."
>
  <PageHeader 
    badge="Preguntas Frecuentes"
    title="Resolvemos tus dudas"
  />
  <section class="py-10 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-3">
        {faqData.map((faq) => (
          <FaqItemCard faq={faq} />
        ))}
      </div>
    </div>
  </section>

</Layout>