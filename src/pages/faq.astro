---
import Layout from '../layouts/Layout.astro';
import ButtonCTA from '../components/ui/ButtonCTA.astro';
import { faqData, faqCategories } from '../data/faqData';
import { siteData } from '../data/siteData';
---

<Layout 
  title="Preguntas Frecuentes | Octubre Consultorio"
  description="Resolvemos tus dudas sobre solicitud de turnos, modalidades presencial y virtual, obras sociales, reintegros y primera consulta en Octubre."
>

  <section class="bg-neutral-surface border-b border-slate-200/80 py-12 sm:py-16">
    <div class="mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-primary-light text-secondary border border-primary/20 mb-4">
        Centro de Ayuda & Respuestas
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-neutral-title tracking-tight mb-4">
        Preguntas Frecuentes
      </h1>
      <p class="text-neutral-text text-base sm:text-lg leading-relaxed">
        Todo lo que necesitás saber antes de tu primera consulta. Queremos acompañarte con claridad desde el primer contacto.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-wrap items-center justify-center gap-2 mb-10" id="category-filters">
        {faqCategories.map((cat, index) => (
          <button
            type="button"
            data-category={cat}
            class={`px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold transition-all duration-200 cursor-pointer ${
              index === 0
                ? "bg-secondary text-white shadow-xs filter-btn-active"
                : "bg-neutral-surface text-neutral-text hover:bg-slate-100 border border-slate-200/80"
            }`}
          >
            {cat}
          </button>
        ))}
      </div>

      <div class="space-y-4" id="faq-accordion">
        {faqData.map((faq) => (
          <div 
            data-category={faq.category}
            class="faq-item bg-neutral-surface rounded-2xl border border-slate-200/80 border-t-2 border-t-primary/60 overflow-hidden shadow-2xs transition-all duration-200"
          >
            <button
              type="button"
              class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 cursor-pointer select-none focus:outline-none"
              aria-expanded="false"
            >
              <div class="space-y-1">
                <span class="text-[11px] font-bold uppercase tracking-wider text-primary block">
                  {faq.category}
                </span>
                <span class="text-base sm:text-lg font-bold text-neutral-title leading-snug block">
                  {faq.question}
                </span>
              </div>
              
              <div class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center shrink-0 text-slate-500 faq-icon transition-transform duration-300">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
              </div>
            </button>

            <div class="faq-content hidden px-6 pb-6 pt-1 text-sm sm:text-base text-neutral-text leading-relaxed border-t border-slate-100/80 mt-1">
              {faq.answer}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqItems = document.querySelectorAll<HTMLElement>('.faq-item');
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('#category-filters button');

    faqItems.forEach((item) => {
      const toggleBtn = item.querySelector('.faq-toggle');
      const content = item.querySelector('.faq-content');
      const icon = item.querySelector('.faq-icon');

      toggleBtn?.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';

        faqItems.forEach((other) => {
          if (other !== item) {
            other.querySelector('.faq-toggle')?.setAttribute('aria-expanded', 'false');
            other.querySelector('.faq-content')?.classList.add('hidden');
            other.querySelector('.faq-icon')?.classList.remove('rotate-45');
          }
        });

        toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
        content?.classList.toggle('hidden');
        icon?.classList.toggle('rotate-45');
      });
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        filterBtns.forEach((b) => {
          b.classList.remove('bg-secondary', 'text-white', 'shadow-xs', 'filter-btn-active');
          b.classList.add('bg-neutral-surface', 'text-neutral-text', 'border', 'border-slate-200/80');
        });

        btn.classList.add('bg-secondary', 'text-white', 'shadow-xs', 'filter-btn-active');
        btn.classList.remove('bg-neutral-surface', 'text-neutral-text', 'border', 'border-slate-200/80');

        faqItems.forEach((item) => {
          const itemCategory = item.getAttribute('data-category');
          if (category === 'Todas' || itemCategory === category) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
  });
</script>